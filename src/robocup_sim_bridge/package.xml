<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robocup_sim_bridge</name>
  <version>0.1.0</version>
  <description>Ground-truth and kick-perception relay for the RoboCup MuJoCo simulation.</description>
  <maintainer email="robocup_sim@todo.todo">robocup_sim</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>yesense_interface</depend>
  <depend>robot_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
