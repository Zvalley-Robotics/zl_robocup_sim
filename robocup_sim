#!/usr/bin/env python3
"""robocup_sim CLI：按角色启动/停止六机比赛仿真。

默认单机全部角色：
    ./robocup_sim up --role all --profile local

分设备：
    ./robocup_sim up --role sim        # 仿真机：MuJoCo + GT/感知 + domain_bridge + 比赛管理
    ./robocup_sim up --role control    # 运控机：roster 中 control_host==本机 的机器人
    ./robocup_sim up --role brain      # 策略机：roster 中 brain_host==本机 的机器人

所有运行产物落在 runtime/<run_id>/（gitignore）。
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import signal
import socket
import subprocess
import sys
import time
import uuid
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parent
RUNTIME = ROOT / "runtime"
ROS_SETUP = "/opt/ros/humble/setup.bash"
DEFAULT_ROSTER = ROOT / "roster.yaml"
DEFAULT_INVENTORY = ROOT / "inventory.yaml"
DEFAULT_ZL_ROOT = "~/zl_robot"
DEFAULT_BRAIN_WS = "~/robocup_demo"


def default_config(name: str, fallback: Path) -> str:
    """优先使用本机私有覆盖 <name>.local.yaml（gitignore），避免把本机配置提交进仓库。"""
    local = ROOT / f"{name}.local.yaml"
    return str(local if local.is_file() else fallback)


# --------------------------------------------------------------------- utils
def external_path(env_key: str, cfg_value: str | None, default: str) -> Path:
    """外部工作区路径：环境变量 > inventory > 默认值；支持 ~ 与 $VAR。"""
    raw = os.environ.get(env_key) or cfg_value or default
    return Path(os.path.expandvars(str(raw))).expanduser()


def die(msg: str, code: int = 1) -> None:
    print(f"[robocup_sim][ERR] {msg}", file=sys.stderr)
    raise SystemExit(code)


def info(msg: str) -> None:
    print(f"[robocup_sim] {msg}")


def load_yaml(path: Path) -> dict:
    if not path.is_file():
        die(f"找不到配置文件: {path}")
    with path.open() as f:
        return yaml.safe_load(f) or {}


def local_ips() -> set[str]:
    ips: set[str] = set()
    try:
        host = socket.gethostname()
        for entry in socket.getaddrinfo(host, None):
            ips.add(entry[4][0])
    except OSError:
        pass
    try:
        out = subprocess.check_output(["hostname", "-I"], text=True, timeout=3)
        ips.update(out.split())
    except (subprocess.SubprocessError, OSError):
        pass
    return ips


def default_iface() -> str:
    try:
        out = subprocess.check_output(
            ["ip", "route", "get", "1.1.1.1"], text=True, timeout=3)
        m = re.search(r"\bdev\s+(\S+)", out)
        if m:
            return m.group(1)
    except (subprocess.SubprocessError, OSError):
        pass
    return "eth0"


def choose_host(inv: dict, explicit: str | None) -> str:
    hosts = inv.get("hosts") or {}
    if not hosts:
        die("inventory.yaml 没有 hosts")
    if explicit:
        if explicit not in hosts:
            die(f"inventory 中没有 host: {explicit}")
        return explicit
    ips = local_ips()
    for name, cfg in hosts.items():
        if str(cfg.get("address", "")) in ips:
            return name
    # 单机开发默认：第一个主机
    first = next(iter(hosts))
    info(f"未按 IP 匹配到 host，回退到 inventory 的第一个 host: {first}")
    return first


def selected_robots(roster: dict, names_csv: str | None) -> list[dict]:
    robots = roster.get("robots") or []
    if not robots:
        die("roster.yaml 没有 robots")
    if not names_csv:
        selected = [r for r in robots if r.get("enabled", False)]
    else:
        wanted = [s.strip() for s in names_csv.replace(",", " ").split() if s.strip()]
        by_name = {r["name"]: r for r in robots}
        missing = [n for n in wanted if n not in by_name]
        if missing:
            die(f"roster 中没有机器人: {' '.join(missing)}")
        selected = [by_name[n] for n in wanted]
    if not selected:
        die("没有可启动的机器人（检查 roster.yaml 的 enabled 或 --robots）")
    return selected


def active_team_ids(roster: dict, robots: list[dict]) -> dict[str, int]:
    match = roster.get("match") or {}
    a_id = int(match.get("team_a_id", 29))
    b_id = int(match.get("team_b_id", 30))
    has_a = any(str(r.get("team", "A")).upper() == "A" for r in robots)
    has_b = any(str(r.get("team", "A")).upper() == "B" for r in robots)
    if has_a and has_b:
        # A+B 同场：避开 brain 队友单播端口族重叠（与旧 lib_players 口径一致）。
        b_id = int(match.get("mixed_b_team_id", match.get("team_b_id_when_mixed", 39)))
    return {"A": a_id, "B": b_id}


def robot_team_id(team_ids: dict[str, int], robot: dict) -> int:
    team = str(robot.get("team", "A")).upper()
    return team_ids.get(team, team_ids["A"])


def mask_of(robots: list[dict]) -> str:
    names = {r["name"] for r in robots}
    bits = []
    for i in range(1, 7):
        bits.append("1" if f"robot_{i:02d}" in names else "0")
    return ",".join(bits)


